# Copie para .env e ajuste. NUNCA faça commit do arquivo .env.
#   cp .env.example .env

# ---------------------------------------------------------------- perfil
# demo  = cria a loja demonstrativa com dados fictícios (ambiente de apresentação)
# prod  = sem dados demonstrativos (uso real)
SPRING_PROFILES_ACTIVE=demo
# true bloqueia credenciais reais de pagamento e força o simulador
APP_DEMO_MODE=true

# ---------------------------------------------------------------- banco
DB_NAME=lojafacil
DB_USER=lojafacil
DB_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------- URLs
APP_FRONTEND_URL=http://localhost:4200
# URL pública HTTPS da API para webhooks do Mercado Pago (ex.: túnel ngrok em desenvolvimento)
APP_PUBLIC_API_URL=http://localhost:8080

# ---------------------------------------------------------------- segurança
# Chave AES-256 (32 bytes em Base64) para cifrar credenciais de pagamento.
# Gere com:  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# true em produção (HTTPS): cookie de sessão marcado como Secure
APP_COOKIE_SECURE=false
# Permite transações reais (live_mode) do Mercado Pago. Mantenha false neste projeto.
APP_ALLOW_LIVE_PAYMENTS=false
